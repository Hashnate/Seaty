# App Environment: 'development' or 'production'
ENVIRONMENT=development

# Database connection settings
DATABASE_URL=postgresql://postgres:password@db:5432/seaty

# Secret key for JWT signing
SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_HERE

# Notify.lk SMS Gateway Credentials
NOTIFYLK_USER_ID=YOUR_NOTIFYLK_USER_ID
NOTIFYLK_API_KEY=YOUR_NOTIFYLK_API_KEY
NOTIFYLK_SENDER_ID=NotifyDEMO
NOTIFYLK_API_URL=https://app.notify.lk/api/v1/send
