# App Environment: 'development' or 'production'
ENVIRONMENT=development

# Database connection settings
DATABASE_URL=postgresql://postgres:password@db:5432/seaty

# Secret key for JWT signing
SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_HERE

# Notify.lk SMS Gateway Credentials
NOTIFYLK_USER_ID=YOUR_NOTIFYLK_USER_ID
NOTIFYLK_API_KEY=YOUR_NOTIFYLK_API_KEY
NOTIFYLK_SENDER_ID=NotifyDEMO
NOTIFYLK_API_URL=https://app.notify.lk/api/v1/send

# Firebase Admin SDK (for FCM push notifications)
# Download service account key from: Firebase Console -> Project Settings -> Service Accounts
# Save as firebase-service-account.json in the backend/ directory (DO NOT commit to git)
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json

# Fixed-OTP accounts for App Store / Play review, whose reviewers cannot receive
# our SMS. Format: phone:code,phone:code. Must match the Sign-In Information
# submitted in App Store Connect / Play Console. Use throwaway PASSENGER
# accounts only, and clear this once review is complete.
TEST_OTP_ACCOUNTS=

# ── Bancstac Paycenter Web 4.0 ────────────────────────────────────────────────
# Provided by Bancstac when your payment page instance is set up. Never commit
# real values; never put them in docker-compose.yml (an `environment:` entry
# overrides env_file and would end up in git).
#
# PAYMENT_MODE: off | test | live
#   off  - no gateway calls, /payments/initiate returns 503
#   test - Bancstac test credentials + test endpoint
#   live - real money
PAYMENT_PROVIDER=bancstac
PAYMENT_MODE=off

BANCSTAC_ENDPOINT=
BANCSTAC_CLIENT_ID=
BANCSTAC_AUTH_TOKEN=
BANCSTAC_HMAC_SECRET=
# Must be publicly reachable — Bancstac redirects the payer here with ?reqid=
BANCSTAC_RETURN_URL=https://api.seaty.hashnate.com/api/v1/payments/bancstac/return
