# Compose-level values — docker compose reads `.env` in this directory
# automatically for ${VAR} substitution in docker-compose.yml.
#
#   cp .env.example .env    # then fill in real values
#
# Application settings (SECRET_KEY, DATABASE_URL, Notify.lk credentials) live in
# backend/.env — start from backend/.env.example.
#
# POSTGRES_PASSWORD must match the password inside backend/.env's DATABASE_URL.
# Changing it on an existing deployment does NOT change the database password:
# Postgres only reads it when initialising an empty volume. To rotate for real,
# run ALTER USER inside the db container and update both files together.

POSTGRES_DB=seaty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
